# ---------------------------------------------------------------------------
# Maratona de Melancias — variáveis de ambiente (todas opcionais)
# Copie para `.env`, preencha o que precisar e NUNCA suba o `.env` no git.
# No Streamlit Community Cloud, use "Settings > Secrets" e o formato TOML.
# ---------------------------------------------------------------------------

# Onde o log de navegação fica salvo (SQLite). Em deploy efêmero, use um
# caminho montado em volume persistente.
MARATONA_DB=.data/maratona.db

# --- Acesso por país -------------------------------------------------------
# "block" = aplica a lista; "off" = libera geral.
GEO_MODE=block
ALLOWED_COUNTRIES=BR
# Se o país não puder ser identificado: "allow" (não trava ninguém) ou "block".
UNKNOWN_COUNTRY_POLICY=allow

# Lookup opcional de país por IP (só é chamado se o cabeçalho do CDN faltar).
# Ex.: https://ipapi.co/{ip}/country/
GEO_LOOKUP_URL=

# Checagem opcional de VPN/proxy/datacenter. Best-effort: pode errar.
ENABLE_IP_INTEL=0
IP_INTEL_URL=http://ip-api.com/json/{ip}?fields=status,countryCode,proxy,hosting

# --- Consentimento e privacidade ------------------------------------------
# 1 = exige consentimento (recomendado). 0 = registra direto (só com base legal).
CONSENT_REQUIRED=1
RETENTION_DAYS=90
COOKIE_NAME=melancias_sid
COOKIE_DAYS=30

# Pixel 1x1 opcional (só dispara com consentimento). Deixe vazio para desligar.
ANALYTICS_PIXEL_URL=

# --- Organização ----------------------------------------------------------
# Sem senha, o painel da organização fica fechado.
ADMIN_PASSWORD=

# --- Escala ao vivo -------------------------------------------------------
# Link CSV público da aba "Alocações" do Google Sheets. Vazio = snapshot embutido.
# Ex.: https://docs.google.com/spreadsheets/d/<ID>/export?format=csv&gid=1904051669
SHEET_CSV_URL=

# --- Interface ------------------------------------------------------------
MAX_PHOTO_MB=8
TZ_NAME=America/Sao_Paulo
# Data de liberação do conteúdo especial do app (formato AAAA-MM-DD).
SURPRESA_EM=2026-11-14
